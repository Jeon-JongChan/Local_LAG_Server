# =============================================================================
# Local RAG 간편 환경 설정 템플릿 (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 하드웨어 사양 프리셋 (기본 권장 설정 묶음)
# -----------------------------------------------------------------------------
# 선택지: low (저사양/노트북) | mid (중간/일반 GPU, 기본값) | high (고사양/고용량 VRAM)
# - low : 1.5B 소형 모델, 2K 컨텍스트, CPU 연산, pypdf 파서 (16GB 이하 RAM)
# - mid : 9B 표준 모델, 4K 컨텍스트, Vulkan GPU 가속, opendataloader 파서 (권장)
# - high: 14B+ 대형 모델, 8K 컨텍스트, CUDA 가속 (RTX 3090/4090급 16GB+ VRAM)
PROFILE=mid

# -----------------------------------------------------------------------------
# 2. 하드웨어 가속 & 서빙 엔진
# -----------------------------------------------------------------------------
# 가속 선택: auto (자동 감지) | vulkan (AMD/Intel/범용 GPU) | cuda (NVIDIA) | cpu (CPU 전용)
ACCELERATOR=vulkan

# 서빙 엔진: llama.cpp (기본) | ollama | vllm | sglang | exllamav3 | mlc_llm | llamafile
SERVING_ENGINE=llama.cpp

# -----------------------------------------------------------------------------
# 3. 모델 변경 설정 (자주 변경하는 3대 모델: 챗봇 / 임베딩 / 리랭커)
# -----------------------------------------------------------------------------
# ※ 아래 명시된 값은 PROFILE 프리셋보다 최우선(Override)으로 적용됩니다.

# [3-1. 챗봇(LLM) 모델]
# Hugging Face GGUF 레포지토리 및 파일명
LLAMA_GGUF_REPO=bartowski/Qwen_Qwen3.5-9B-GGUF
LLAMA_GGUF_FILE=Qwen_Qwen3.5-9B-Q4_K_M.gguf
# - 중간 4B   : jc-builds/Qwen3.5-4B-Q4_K_M-GGUF / Qwen3.5-4B-Q4_K_M.gguf
# - 저사양 1.5B: bartowski/Qwen_Qwen2.5-1.5B-Instruct-GGUF / Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
# - 고사양 14B : bartowski/Qwen_Qwen2.5-14B-Instruct-GGUF / Qwen2.5-14B-Instruct-Q4_K_M.gguf
# - 초경량 0.5B: bartowski/Qwen_Qwen2.5-0.5B-Instruct-GGUF / Qwen2.5-0.5B-Instruct-Q4_K_M.gguf

# [3-2. 임베딩 모델]
# Hugging Face Repo ID (문서 벡터화)
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# - 대안 1: BAAI/bge-m3 (다국어 1024차원)
# - 대안 2: jhgan/ko-sroberta-multitask (한국어 특화 768차원)

# [3-3. 리랭킹 모델 & 전략]
# 전략 선택: origin (기본, Qwen 로짓/크로스인코더) | laya (Laya Multilingual) | clm (Contrastive-LM API)
RERANK_STRATEGY=origin
# 리랭커 모델 ID (origin 전략 사용 시)
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# - laya 전략 전용 모델: convaiinnovations/laya-multilingual

# -----------------------------------------------------------------------------
# 4. 파서 및 부가 설정
# -----------------------------------------------------------------------------
# 문서 파서: PROFILE 프리셋 자동 연동 (low: pypdf / mid·high: opendataloader)
# 특정 파서로 강제 고정하려면 주석 해제:
# DOC_PARSER=opendataloader

# 웹 UI 포트
WEB_PORT=8787

# -----------------------------------------------------------------------------
# 5. 서빙 및 색인 고급 튜닝 (기존 local-rag.bat 파라미터)
# -----------------------------------------------------------------------------
# LLAMA_THREADS=8
# LLAMA_THREADS_BATCH=16
# LLAMA_FLASH_ATTN=on
# LLAMA_BATCH_SIZE=1024
# LLAMA_UBATCH_SIZE=256
# HYBRID_BM25=1
# BM25_TOP_K=20
# CHUNK_MIN_CHARS=200
# CHUNK_MAX_CHARS=800
