# 우선순위: .env/셸 > 엔진 프리셋 > PROFILE > default
# PROFILE= low|mid|high  (엔진은 안 바꿈)
PROFILE=mid

# ACCELERATOR= auto|gpu|cuda|vulkan|cpu  (auto=GPU>Vulkan>CPU)
ACCELERATOR=auto

# SERVING_ENGINE= llama.cpp|ollama|vllm|sglang|exllamav3|mlc_llm|llamafile|openai
SERVING_ENGINE=llama.cpp

# --- llama.cpp: LLAMA_GGUF_REPO/FILE, LLAMA_CPP_VARIANT=auto|cpu|vulkan|cuda, CTX_SIZE, NGL, BASE_URL ---
# LLAMA_GGUF_REPO=bartowski/Qwen_Qwen3.5-9B-GGUF
# LLAMA_GGUF_FILE=Qwen_Qwen3.5-9B-Q4_K_M.gguf

# --- ollama: OLLAMA_MODEL=qwen2.5:1.5b|7b|14b , OLLAMA_BASE_URL ---
# --- vllm: VLLM_MODEL=Qwen/Qwen2.5-*-Instruct , VLLM_BASE_URL ---
# --- sglang/exllamav3/mlc_llm/llamafile: 각 *_MODEL , *_BASE_URL ---

# EMBED_MODEL= HF id (디바이스는 ACCELERATOR 설정을 따름)
# RERANK_STRATEGY= origin|laya|clm
# RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# DOC_PARSER= opendataloader|pypdf
# FAISS_TOP_K=4|8|16  RERANK_TOP_K=2|4|6|0  HYBRID_BM25=1|0
# WEB_HOST=0.0.0.0  WEB_PORT=8787
WEB_PORT=8787
